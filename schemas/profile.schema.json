{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devkit.example/schemas/profile.schema.json",
  "title": "DevKit Developer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "maintainer": {
      "type": "string"
    },
    "supported_platforms": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "required",
          "version_policy"
        ],
        "properties": {
          "package_id": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "version_policy": {
            "type": "string",
            "enum": [
              "stable",
              "latest",
              "exact",
              "channel"
            ]
          },
          "version": {
            "type": "string"
          },
          "channel": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
