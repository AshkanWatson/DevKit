{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devkit.example/schemas/profile.schema.json",
  "title": "DevKit Developer Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "packages"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "maintainer": {
      "type": "string"
    },
    "supported_platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "windows-x64",
          "windows-arm64",
          "macos-x64",
          "macos-arm64",
          "linux-x64",
          "linux-arm64"
        ]
      },
      "description": "Platforms this profile is intended for. Optional; when absent the profile is considered platform-neutral and each package's own support is decisive."
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "package_id",
          "required",
          "version_policy"
        ],
        "properties": {
          "package_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
            "description": "Stable package ID as published in the catalog (package manifest id)."
          },
          "required": {
            "type": "boolean"
          },
          "version_policy": {
            "type": "string",
            "enum": [
              "stable",
              "latest",
              "exact",
              "channel"
            ]
          },
          "version": {
            "type": "string",
            "description": "Concrete version. Required when version_policy is exact; otherwise advisory."
          },
          "channel": {
            "type": "string",
            "description": "Channel name. Required when version_policy is channel."
          },
          "reason": {
            "type": "string",
            "description": "Human-readable explanation shown in the profile editor and plan review."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "version_policy": { "const": "exact" }
              }
            },
            "then": {
              "required": ["version"]
            }
          },
          {
            "if": {
              "properties": {
                "version_policy": { "const": "channel" }
              }
            },
            "then": {
              "required": ["channel"]
            }
          }
        ]
      },
      "description": "Package selections. Package IDs must be unique within a profile; the publication validator (Phase 2) rejects duplicates."
    }
  }
}
